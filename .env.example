# 中央氣象署 (CWA) Open Data API Key
# 請至 https://opendata.cwa.gov.tw/ 會員中心取得授權碼
CWA_API_KEY=YOUR_CWA_API_KEY_HERE

# Ministry of Environment Open Data API Key (air quality AQI data)
# Register at https://data.moenv.gov.tw/ and keep the real key in your local .env only.
MOENV_API_KEY=YOUR_MOENV_API_KEY_HERE
